{
	"name": "luminevent",
	"version": "1.2.1",
	"description": "Luminevent is a backend service for managing and organizing events, providing APIs for event creation, user management, and scheduling.",
	"main": "build/index.js",
	"scripts": {
		"clean": "rimraf --glob build/* drizzle/* logs/* *-audit.json *.log",
		"start": "node build/src/index.js",
		"dev": "nodemon",
		"dev:verbose": "nodemon --verbose",
		"dev:worker": "ts-node src/workers/index.ts",
		"prod:worker": "node build/workers/index.ts",
		"start:dev": "concurrently \"pnpm dev\" \"pnpm dev:worker \"",
		"start:prod": "concurrently \"pnpm build\" \"pnpm start\" \"pnpm prod:worker \"",
		"pm2:prod": "pm2 start pm2.config.cjs --env production",
		"pm2:dev": "pm2 start pm2.config.cjs --env development",
		"pm2:restart": "pm2 restart all",
		"pm2:stop": "pm2 stop all",
		"pm2:reload": "pm2 reload all",
		"pm2:logs": "pm2 logs",
		"pm2:list": "pm2 list",
		"build": "tsc",
		"api:oas": "tsoa spec",
		"api:generate": "tsoa spec-and-routes -c ./tsoa.json",
		"api:routes": "tsoa routes",
		"api:build": "tsoa spec-and-routes && tsc",
		"db:generate": "drizzle-kit generate",
		"db:push": "drizzle-kit push",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"lint": "eslint '../**/*.ts'",
		"test": "tsx node_modules/mocha/bin/mocha \"src/tests/**/*.test.ts\""
	},
	"engines": {
		"node": ">=18"
	},
	"packageManager": "pnpm@9.15.4",
	"keywords": [],
	"author": "BITS",
	"license": "Apache-2.0",
	"dependencies": {
		"@paystack/paystack-sdk": "^1.0.1",
		"@sendgrid/mail": "^8.1.5",
		"@tsoa/runtime": "^6.6.0",
		"bcrypt": "^6.0.0",
		"bullmq": "^5.56.9",
		"celebrate": "^15.0.3",
		"cloudinary": "^2.7.0",
		"concurrently": "^9.2.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.5",
		"date-fns": "^4.1.0",
		"dotenv": "^17.2.1",
		"drizzle-orm": "^0.44.4",
		"express": "^5.1.0",
		"express-generator": "^4.16.1",
		"express-jwt": "^8.5.1",
		"express-rate-limit": "^8.0.1",
		"express-rate-limiter": "^1.3.1",
		"helmet": "^8.1.0",
		"joi": "^17.13.3",
		"jsonwebtoken": "^9.0.2",
		"method-override": "^3.0.0",
		"nanoid": "^5.1.5",
		"nodemailer": "^7.0.5",
		"passport": "^0.7.0",
		"passport-google-oauth20": "^2.0.0",
		"passport-google-oidc": "^0.1.0",
		"pdfmake": "^0.2.20",
		"pg": "^8.16.3",
		"pm2": "^6.0.8",
		"redis": "^5.8.0",
		"reflect-metadata": "^0.2.2",
		"resend": "^4.8.0",
		"swagger-ui-express": "^5.0.1",
		"uuid": "^11.1.0",
		"winston": "^3.17.0",
		"winston-daily-rotate-file": "^5.0.0",
		"winston-telegram": "^2.7.0",
		"zod": "^4.0.15"
	},
	"devDependencies": {
		"@types/bcrypt": "^6.0.0",
		"@types/cookie-parser": "^1.4.9",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.3",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/method-override": "^3.0.0",
		"@types/node": "^24.2.0",
		"@types/nodemailer": "^6.4.17",
		"@types/passport": "^1.0.17",
		"@types/passport-google-oauth20": "^2.0.16",
		"@types/passport-strategy": "^0.2.38",
		"@types/pdfmake": "^0.2.11",
		"@types/pg": "^8.15.5",
		"@types/redis": "^4.0.11",
		"@types/swagger-ui-express": "^4.1.8",
		"drizzle-kit": "^0.31.4",
		"eslint": "^9.32.0",
		"globals": "^16.3.0",
		"husky": "^9.1.7",
		"jest": "^30.0.5",
		"nodemon": "^3.1.10",
		"prettier": "^3.6.2",
		"ts-jest": "^29.4.1",
		"ts-node": "^10.9.2",
		"tsoa": "^6.6.0",
		"typescript": "^5.9.2"
	}
}
